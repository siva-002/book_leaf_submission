PORT=5000
NODE_ENV=development
JWT_SECRET=bookleaf_jwt_secret_key_2026_super_secure
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookleaf
DB_USER=postgres
DB_PASSWORD=postgres
# Optional URL alternative:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/bookleaf

# AI Integration: OpenRouter (Free Models) or OpenAI
# Sign up at https://openrouter.ai and grab a free API key at https://openrouter.ai/settings/keys
# Popular 100% Free OpenRouter Models:
# - meta-llama/llama-3.3-70b-instruct:free (Recommended, state-of-the-art 70B)
# - google/gemini-2.0-flash-exp:free (Fast & smart)
# - deepseek/deepseek-r1:free (Reasoning)
# - mistralai/mistral-7b-instruct:free
# - qwen/qwen-2.5-coder-32b-instruct:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI Alternative (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

